# Porta em que a aplicacao escuta
PORT=3000
# Diretorio onde os PDFs enviados e os dados das transcricoes sao guardados
DATA_DIR=/data
# Tamanho maximo de upload em bytes (padrao 20MB)
MAX_UPLOAD_BYTES=20971520
# Tempo de retencao dos arquivos em horas (apagados apos esse periodo)
RETENTION_HOURS=24
